                 </span>
              {% endfor %}
              </div>
              <div class="review_content">
                <p class="content">{{ block.settings.review_content }}</p>
              </div>
              <a href="javascript:void(0)" class="toggleBtn">Read More</a>
            </div>
          </div>
          {% endfor %}
        </div>
          <div class="swiper-button-next"></div>
          <div class="swiper-button-prev"></div>
        <div class="swiper-pagination"></div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Testimonial-section",
  "settings": [
     {
    "id": "testomial_heading",
    "type":"text",
    "label":"testimonial Heading Name"
    },
    {
    "id": "testomial_title",
    "type":"text",
    "label":"testimonial client name"
    },
    {
    "id": "testomial_stars",
    "type":"image_picker",
    "label":"testimonial Rating"
    },
    {
    "id": "testomial_content",
    "type":"richtext",
    "label":"testimonial content"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name":"Review",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "review_heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "review_star",
          "label": "Review Star"
        },
        {
          "type": "richtext",
          "id": "review_content",
          "label": "Review Content"
        }
      ]
    }
  ],
  "presets": [
  {
    "name": "Testimonial Section",
  }
]
}
{% endschema %}
<style>
  .page-width {
  		max-width: 1200px;
  		width: 100%;
  		margin: 0 auto;
  	}
  	.testimonial_main {
  		width: 100%;
  		position: relative;
  	}
  	.tetimonial-sub {
  		width: 100%;
  		position: relative;
  	}
  	.testimonial_all_main {
  		border: 1px solid #8f8f8f;
  		border-radius: 10px;
  		padding: 20px 10px;
  	}
  	.review_name h3 {
  		margin: 0px 0px 10px 0px;
  		font-size: 1.25rem;
  		color: #065c2f;
  	}
  	.review_star {
  		width: 22px;
  		display: flex;
  		align-items: center;
  		gap: 8px;
  	}
  	.review_star img {
  		width: 100%;
  	}
  	.review_content {
  		color: #065c2f;
  		margin-top: 10px;
  	}
  	.content {
  		display: inline;
  	}
  	.toggleBtn {
  		display: block;
  		text-decoration: none;
  		font-size: 15px;
  		font-weight: 600;
  		color: #065c2f;
  		margin-top: 5px;
  		cursor: pointer;
  	}
  .testomonial_heading h1 {
    text-align: center;
    color: #065c2f;
  }
</style>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script
  src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
  integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
></script>

<script>
   document.addEventListener("DOMContentLoaded", function() {
     const contentElements = document.querySelectorAll(".content");  // Get all content elements
     const toggleBtns = document.querySelectorAll(".toggleBtn");     // Get all toggle buttons

     const maxWords = 10;  // Limit to 10 words

  
     function truncateText(text, wordLimit) {
       const words = text.split(" ");
       if (words.length > wordLimit) {
         return words.slice(0, wordLimit).join(" ") + "...";
       }
       return text;
     }

     // Loop through each testimonial and add functionality
     contentElements.forEach((contentElement, index) => {
       const fullText = contentElement.innerHTML;  // Full text for each content element
       let isTruncated = true;  // Initial state is truncated

       // Initial display of truncated text
       contentElement.innerHTML = truncateText(fullText, maxWords);

       // Add event listener to the corresponding toggle button
       toggleBtns[index].addEventListener("click", function() {
         if (isTruncated) {
           contentElement.innerHTML = fullText;  // Show full text
           toggleBtns[index].innerHTML = "Read Less";  // Change button text to 'Read Less'
         } else {
           contentElement.innerHTML = truncateText(fullText, maxWords);  // Show truncated text
           toggleBtns[index].innerHTML = "Read More";  // Change button text to 'Read More'
         }
         isTruncated = !isTruncated;  // Toggle the state
       });
     });
   });

  var swiper = new Swiper(".mySwiper", {
         slidesPerView: 3,
         spaceBetween: 30,
         freeMode: true,
         pagination: {
           el: ".swiper-pagination",
           clickable: true,
         },  
        navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev"
        },
      });
</script>
