<div class="testimonial_main">
  <div class="page-width">
    <div class="tetimonial-sub">
      <div class="testomonial_heading"><h1>{{ section.settings.testomial_heading }}</h1></div>
      <div class="swiper mySwiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
          <div class="swiper-slide">
            <div class="testimonial_all_main">
              <div class="review_name">
                <h3>{{ block.settings.review_heading }}</h3>
              </div>
              <div class="review_star">
                {% assign stars = block.settings.review_star %}
               {% for star in (1..stars) %} 
