<style>
.connect_main {
    width: 100%;
    position: relative;
    padding-top: 60px;
    padding-bottom: 60px;
}
span.connect_cust {
    color: blue;
}
.connect_left_side_main {
    width: 50%;
}
h2.connect_ {
    font-size: 32px;
    font-weight: 600;
    text-align: center;
    padding: 20px 0px;
}
.swiper.swiper-cards {
    overflow: hidden !important;
}
.connect_left_side {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  
}
.connect_left_upper_image img {
    width: 100%;
    height: 100%;
    object-fit:cover;
}
.connect_left_side {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    row-gap: 10px;
}
.connect_left_upper_image img {
    width: 100%;
    height: 100%;
        vertical-align: middle;
}

.connect_left_upper_image {
    border-radius: 30px;
    overflow: hidden;

    width: 49%;
}
  .connect_right_side {
    width: 100%;
}
  .connect-sub .swiper-slide img {
    width: 48%;
    border-radius: 4%;
}
.connect_main_boxs {
    display: flex;
    justify-content: space-evenly;
    width: 100%;
}
.connect-sub {
    width: 100%;
    position: relative;
}
 {% comment %} .connect-sub .swiper-slide.swiper-slide-next {
    transform:  translate3d(calc(7.25% - 720px), 0px, -100px) rotateZ(12deg) scale(1) !important;
}  {% endcomment %}
.connect-sub  .swiper-slide.swiper-slide-prev {
    transform: translate3d(calc(-7.25% + 0px), 0px, -100px) rotateZ(-12deg) scale(1)!important;
}
.connect-sub .swiper-slide.swiper-slide-next {
    transform: translate3d(calc(-68.75% - 720px), 0px, -100px) rotateZ(12deg) scale(1) !important;
}
.connect_right_side_main {
    width: 50%;
    padding-top: 20px;
}
.connect_right_side_main .swiper-slide {
    text-align: center;
}
</style> 
 <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script>
    var swiper = new Swiper(".mySwiper", {
      effect: "cards",
      grabCursor: true,
    });
  </script>