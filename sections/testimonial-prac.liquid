<style>
      .rating-imaage img{
        width:100%;
            vertical-align: middle;
      }

      .testiomial-main {
        width: 100%;
        position: relative;
        padding-top: 60px;
        padding-bottom: 60px;
    }
      .testiomial-sub{
        width: 100%;
        position: relative;
    }
      .testimonial-main-boxs {
        width: 100%;

    }
  .testimonial-box {
      border: 1px solid #000;
      border-radius: 20px;
      padding: 15px;

  }
      .rating-imaage {
        width: 40%;
    }
      .client_name h2 {
        margin: 0;
        padding-bottom: 5px;
    }
      .revie-containt p {
        margin: 0;
        padding: 8px 0;
    }
      .page-width {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding:0;
    }
    .testiomial-sub .swiper-wrapper {
    padding-bottom: 43px;
}
  .testimonial-boxs .swiper-button-next ,.testimonial-boxs .swiper-button-prev {
    display: block !important;
  }
  .testimonial-boxs .swiper-button-next{
    right: 0;
    top: 55%;
    transform: translate(-82%, -50%);
  }
  .testiomial-sub h2.heading-testomonial {
    padding-bottom: 40px;
    font-size: 30px;
    text-align: center;
}
.swiper-button-prev:after, .swiper-rtl .swiper-button-next:after {
    content: 'prev';
    font-size: 16px;
    border: 2px solid #000;
      padding: 9px;
    border-radius: 29px;
    color: #000;
    font-weight: bolder;
    padding-left: 13px;
    padding-right: 13px;

}
.swiper-button-next:after, .swiper-rtl .swiper-button-prev:after {
    content: 'next';
    font-size: 16px;
    border: 2px solid #000;
    padding: 9px;
    border-radius: 29px;
    color: #000;
    font-weight: bolder;
    padding-left: 13px;
    padding-right: 13px;

</style>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  var swiper = new Swiper(".demo", {
      direction: 'horizontal',
    slidesPerView: 3,
    spaceBetween: 30,
    navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      pagination: {
        el: ".swiper-pagination",
      },
  });
</script>
