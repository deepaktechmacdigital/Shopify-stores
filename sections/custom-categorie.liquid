<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<style>
    *{
    margin:0;
    padding:0;
    }
      .categories_main {
        width: 100%;
        position: relative;
        background: #000;
        padding-top: 60px;
        padding-bottom: 60px;
    }
        .categories_sub {
        width: 100%;
        position: relative;
    }
      .categories_heading h2 {
        margin: 0;
        text-align: center;
    }
     .categories_heading h2.categories_upper_heading, .categories_heading h2.categories_down_heading {
        font-size: 30px;
        font-weight: 600;
    }
    .categories_upper_heading{
      color:#fff;
    }
     .categories_heading h2.categories_down_heading {
        color: #1212da;
    }
    .categories_section_main {
        width: 60%;
        margin: 0 auto;
        position: relative;
        margin-top: 20px;
        display: flex;
        gap: 20px;
    }
      .categories_left_side_section {
        width: 60%;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 20px;
    }
    .categories_right_side_section {
      width: 42%;
      position: relative;
      padding: 15px;
      border-radius: 11px;
      border: 1px solid #000;
      background: #fff;
    }

      .categories_left_upper_image {
        background: yellow;
        padding: 15px 24px;
        border-radius: 15px;
        text-align: center;
    }
      .categories_left_down_image {
        background: #5f5dc5;
        padding: 50px 27px 20px 15px;
        border-radius: 15px;
        text-align: left;
        width: 80%;
        color: #fff;
    }
      .categories_left_down_image:last-child {
        background: #ffabab;
        padding: 50px 27px 20px 15px;
        border-radius: 15px;
        text-align: left;
        width: 80%;
         color: #000;
    }
    .categories_left_upper_image {
        width: 80%;
        background: #b1ffc3;
        padding: 50px 27px 20px 15px;
        border-radius: 15px;
        text-align: left;
    }
    .categories_left_upper_image:last-child {
       width: 80%;
        background: #fee7ae;
        padding: 50px 27px 20px 15px;
        border-radius: 15px;
        text-align: left;
    }
    .categories_left_side__upper_section {
        width: 100%;
        display: flex;
        gap: 15px;
        justify-content: center;
    }
    .categories_left_side__down_section {
        width: 100%;
        display: flex;
        gap: 15px;
        justify-content: center;
    }
    .categories_left_upper_image p {
        font-size: 18px;
        font-weight: 500;
        line-height: 20px;
    }
    span.bolt_text_cate {
        font-weight: 600;
        display: block;
    }
    .image_categories_star img {
      width: 100%;
  }
  .image_categories_star {
      width: 40%;

  }
  .contain_categories p {
     font-size: 12px;
      line-height: 16px;
      word-spacing: 0px;
      letter-spacing: 1px;
  }
  .categories_client_name {
      margin-top: 10px;
  }
  .categories_right_side_section_flex {
      display: flex;
      flex-direction: column;
      gap: 55px;
  }
  .categories_left_down_image p {
    line-height: 20px;
  }
.slient_image img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
}
.slient_image {
    width: 30px;
    height: 30px;
}
.client_image_div {
    display: flex;
    align-items: center;
    width: 100%;
}
</style>



<script>
  var swiper = new Swiper(".categories_script_class", {
    paginationClickable:true,
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
    pagination: {
      el: ".swiper-pagination",
    },
    mousewheel: true,
    keyboard: true,
  });
</script>